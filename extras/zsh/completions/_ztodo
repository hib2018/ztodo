#compdef ztodo

_ztodo_task_ids() {
  local line
  local -a tasks

  for line in "${(@f)$(ztodo ls 2>/dev/null)}"; do
    if [[ "$line" =~ '^\[[ x]\] ([0-9]+)  (.*)$' ]]; then
      tasks+=("${match[1]}:${match[2]}")
    fi
  done

  if (( ${#tasks} )); then
    _describe -t tasks 'task' tasks
  else
    _message 'no tasks'
  fi
}

_ztodo() {
  local context state state_descr line
  typeset -A opt_args
  local -a commands

  commands=(
    'add:Add a task'
    'ls:List todo and done tasks'
    'done:Mark a task as done'
    'move:Move a task to a display position'
    'del:Delete a task without confirmation'
    'clear:Delete all tasks'
    'repo:Manage configured GitHub repositories'
    'issue:Select a GitHub Issue and copy an AI prompt'
    'import:Import Proposal JSON from the clipboard'
    'prop:Review, edit, and approve the current Proposal'
    'prompt:Manage custom AI prompt instructions'
    'help:Show help'
    'version:Show version'
  )

  _arguments -C \
    '1:command:->command' \
    '*::argument:->argument'

  case "$state" in
    command)
      _describe -t commands 'ztodo command' commands
      ;;
    argument)
      case "${words[2]}" in
        add)
          _message 'task title'
          ;;
        done|del)
          _ztodo_task_ids
          ;;
        move)
          if (( CURRENT == 3 )); then
            _ztodo_task_ids
          elif (( CURRENT == 4 )); then
            _message 'destination position'
          fi
          ;;
        issue)
          _message 'repository (owner/repo); omit to use all configured repositories'
          ;;
        repo)
          if (( CURRENT == 3 )); then
            local -a repo_commands=(
              'ls:List configured repositories'
              'add:Add a repository'
              'del:Remove a repository'
            )
            _describe -t repo-commands 'repo command' repo_commands
          elif (( CURRENT == 4 )); then
            case "${words[3]}" in
              add|del)
                _message 'repository (owner/repo)'
                ;;
            esac
          fi
          ;;
        prompt)
          if (( CURRENT == 3 )); then
            local -a prompt_commands=(
              'show:Show custom instructions'
              'edit:Edit custom instructions'
              'preview:Preview the complete prompt'
              'reset:Delete custom instructions'
            )
            _describe -t prompt-commands 'prompt command' prompt_commands
          fi
          ;;
      esac
      ;;
  esac
}

_ztodo "$@"
